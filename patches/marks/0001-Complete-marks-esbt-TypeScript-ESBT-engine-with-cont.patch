+  write(w: Writer): void {
+    w.uint(this.sites.length);
+    for (const site of this.sites) w.str(site);
+  }
+
+  static read(r: Reader): SiteId[] {
+    const count = r.uint();
+    const sites: SiteId[] = [];
+    for (let i = 0; i < count; i++) sites.push(r.str());
+    return sites;
+  }
