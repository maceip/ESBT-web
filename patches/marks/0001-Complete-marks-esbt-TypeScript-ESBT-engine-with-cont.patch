+  keys(): string[] {
+    const now = Date.now();
+    const out: string[] = [];
+    for (const [key, entry] of this.entries) {
+      if (this.live(entry, now)) out.push(key);
+    }
+    return out;
+  }
+
+  getAllStates(): Record<string, unknown> {
+    const now = Date.now();
+    const out: Record<string, unknown> = {};
+    for (const [key, entry] of this.entries) {
+      if (this.live(entry, now)) out[key] = entry.value;
+    }
+    return out;
+  }
