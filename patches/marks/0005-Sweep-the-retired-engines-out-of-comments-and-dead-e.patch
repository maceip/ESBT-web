From a22a7fa085ff8f846ecfd0a8ae18b71e71fd9ecd Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 21 Aug 2026 23:43:43 +0000
Subject: [PATCH 5/5] Sweep the retired engines out of comments and dead
 exports
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Protocol headers describe ESBT rooms, the editor exception-sink note no
longer explains loro-codemirror internals, and the unused TEXT_KEY
container name is gone — the ESBT doc has a single implicit text.
---
 client/src/collab/protocol.ts |  2 +-
 client/src/collab/types.ts    |  3 ---
 client/src/editor/setup.ts    | 10 ++++------
 server/src/protocol.ts        |  4 ++--
 4 files changed, 7 insertions(+), 12 deletions(-)

diff --git a/client/src/collab/protocol.ts b/client/src/collab/protocol.ts
index 96c56bd..9311226 100644
--- a/client/src/collab/protocol.ts
+++ b/client/src/collab/protocol.ts
@@ -1,5 +1,5 @@
 /**
- * Wire protocol for the Loro sync rooms.
+ * Wire protocol for the ESBT sync rooms.
  * Keep this file in sync with `server/src/protocol.ts`.
  */
 export const MSG_UPDATE = 0x01;
diff --git a/client/src/collab/types.ts b/client/src/collab/types.ts
index 40aa700..b6b7522 100644
--- a/client/src/collab/types.ts
+++ b/client/src/collab/types.ts
@@ -70,6 +70,3 @@ export interface SessionOptions {
   docId: string;
   user: LocalUser;
 }
-
-/** Shared container/type name for the markdown source. Must match the server. */
-export const TEXT_KEY = 'markdown';
diff --git a/client/src/editor/setup.ts b/client/src/editor/setup.ts
index 85b89d4..22db575 100644
--- a/client/src/editor/setup.ts
+++ b/client/src/editor/setup.ts
@@ -21,12 +21,10 @@ import { editorTheme, markdownHighlighting } from './theme';
 /**
  * Positions that briefly outrun the local document.
  *
- * The collaborative bindings resolve remote cursors and undo selections
- * against the CRDT, which can be a step ahead of the editor while a change is
- * still being applied — loro-codemirror restores an undo selection in the same
- * transaction that rewrites the document, for instance. CodeMirror routes the
- * failure here and recovers on the next update, so these are noise. Anything
- * else deserves to be seen.
+ * The presence layer resolves remote cursors against the CRDT, which can be a
+ * step ahead of the editor while a change is still being applied. CodeMirror
+ * routes the failure here and recovers on the next update, so these are
+ * noise. Anything else deserves to be seen.
  */
 const TRANSIENT_BINDING_ERROR =
   /Invalid position \d+ in document|No tile at position|property 'tile' of/;
diff --git a/server/src/protocol.ts b/server/src/protocol.ts
index 4c1f1fc..cb31afb 100644
--- a/server/src/protocol.ts
+++ b/server/src/protocol.ts
@@ -1,10 +1,10 @@
 /**
- * Wire protocol for the Loro sync rooms.
+ * Wire protocol for the ESBT sync rooms.
  *
  * Every frame is binary: one tag byte followed by an opaque payload. Keep this
  * file in sync with `client/src/collab/protocol.ts`.
  */
-export const MSG_UPDATE = 0x01; //  both ways: Loro update or snapshot bytes
+export const MSG_UPDATE = 0x01; //  both ways: ESBT update or snapshot bytes
 export const MSG_EPHEMERAL = 0x02; //  both ways: presence, relayed but never persisted
 export const MSG_SERVER_VV = 0x03; //  server -> client: oplog version vector
 export const MSG_SNAPSHOT = 0x04; //  server -> client: document snapshot
-- 
