{
  "name": "esbt-web-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "node demo/server.mjs",
    "showcase": "node demo/showcase.mjs",
    "build:wasm": "bash tools/build-wasm.sh",
    "generate:abi": "node tools/wasm-abi.mjs",
    "check:abi": "node tools/wasm-abi.mjs --check",
    "test:wasm": "npm run build:wasm && node tools/wasm-abi.mjs --check --verify-wasm web/esbt.wasm && node demo/wasm-smoke.mjs"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "puppeteer-core": "^24.0.0",
    "ws": "^8.18.0",
    "agent-browser": "^0.8.0"
  }
}
